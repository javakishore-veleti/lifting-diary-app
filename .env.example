# Copy this file to `.env` and replace every value below.
#
# PLACEHOLDERS ONLY -- never commit real credentials here. `.env` and every
# other `.env*` file is gitignored; this example is the deliberate exception
# (see the `!.env.example` negation in .gitignore) so that the set of required
# variables is discoverable from a clone.

# --- Database -------------------------------------------------------------
# Local Postgres served by DevOps/Local/Postgres/docker-compose.yaml.
# Start it with: ./DevOps/Local/docker-all-up.sh
# The value below matches that compose file's local-only credentials, so it
# works as-is for local development.
DATABASE_URL=postgresql://lifting_diary:local_dev_only@localhost:5432/lifting_diary

# --- Authentication (Clerk) -----------------------------------------------
# Obtain these from your Clerk dashboard: https://dashboard.clerk.com/
# The secret key is a real credential -- keep it out of version control.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk routing. These are route paths, not secrets, so NEXT_PUBLIC_ is
# correct and the values below work as-is.
#
# Use the FALLBACK redirect variables, never the FORCE_ variants: fallback
# applies only when no destination was remembered, so a deep link to a
# protected route still returns the user there after signing in. A forced
# redirect always wins, which silently breaks deep linking while still
# passing a casual sign-in test.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
